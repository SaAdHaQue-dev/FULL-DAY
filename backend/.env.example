# Server Configuration
PORT=5000
NODE_ENV=production

# MongoDB Connection String (Replace with your free MongoDB Atlas URI)
# Example: mongodb+srv://admin:YourPassword123@cluster0.xyz.mongodb.net/taskora?retryWrites=true&w=majority
MONGODB_URI=

# Frontend URL on Vercel (optional for CORS; *.vercel.app is allowed by default)
FRONTEND_URL=https://your-frontend.vercel.app
