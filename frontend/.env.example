# Render Backend REST API Endpoint
# In production on Vercel, set this to your Render backend URL (e.g. https://taskora-backend.onrender.com/api)
# In local development, you can point to http://localhost:5000/api
VITE_API_URL=https://your-backend.onrender.com/api

# Google Gemini API Key (Optional - can also be pasted directly in the app UI)
# Get a free key at: https://aistudio.google.com/app/apikey
VITE_GEMINI_API_KEY=
